{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Simpu",
  "version": "0.1.0",
  "identifier": "dev.simpu.app",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../../ui run dev",
    "beforeBuildCommand": "npm --prefix ../../ui run build"
  },
  "app": {
    "windows": [
      { "title": "Simpu", "width": 1200, "height": 800, "minWidth": 640, "minHeight": 400, "dragDropEnabled": true }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
